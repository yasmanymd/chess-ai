POSTGRES_DB=chess_ai
POSTGRES_USER=chess_ai
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql://chess_ai:change-me-for-local-use@postgres:5432/chess_ai
DATABASE_POOL_MAX=10
SERVER_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.12:5173
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_IDENTITY_MAX_PER_MINUTE=10
RATE_LIMIT_GAME_MAX_PER_MINUTE=60

# Release reference only. Do not commit production credentials.
CHESS_AI_DOMAIN=chess.example.com
CADDY_EMAIL=operator@example.com
